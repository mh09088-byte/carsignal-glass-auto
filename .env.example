# glass-auto - 환경변수 예시
#
# 이 파일을 ".env" 로 복사해 실제 값을 채우세요. ".env" 는 커밋하지 않습니다.
# "ws save" 를 하면 CLAUDE-SYNC\env\glass-auto\ 에 사본이 보관됩니다.
#
# 서명 정보가 없으면 build-apk.ps1 은 debug 키로 서명한 실행 가능한 APK를 만듭니다.
# NOTE: UTF-8 로 저장하세요.

# release 키스토어 경로. 비워 두면 CLAUDE-SYNC\env\glass-auto\release.jks 를 찾습니다.
GLASSAUTO_KEYSTORE=
GLASSAUTO_KEYSTORE_PASSWORD=
GLASSAUTO_KEY_ALIAS=glassauto
GLASSAUTO_KEY_PASSWORD=
